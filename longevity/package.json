{
  "name": "longevity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Longevity — portal i aplikacja mobilna programu Długowieczności (HCPL / FDP)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --import tsx --test packages/*/test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "demo": "node --import tsx scripts/demo.ts",
    "panel": "npm run dev --workspace @longevity/panel",
    "panel:build": "npm run build --workspace @longevity/panel",
    "panel:e2e": "node --import tsx apps/panel/e2e/przejscie.mts",
    "hr:build": "npm run build --workspace @longevity/hr",
    "hr:e2e": "node --import tsx apps/hr/e2e/przejscie.mts",
    "trener:build": "npm run build --workspace @longevity/trener",
    "trener:e2e": "node --import tsx apps/trener/e2e/przejscie.mts",
    "audytor:build": "npm run build --workspace @longevity/audytor",
    "audytor:e2e": "node --import tsx apps/audytor/e2e/przejscie.mts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
