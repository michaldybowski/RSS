{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "composite": false,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@longevity/core": [
        "packages/core/src/index.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts"
  ],
  "exclude": [
    "apps/**"
  ]
}
